// Arquivos, dependências e, em platform/convex/lib/, exports sem uso (`bun run knip:check`,
// tarefa `ci:knip` do grafo `validate`). Cada exceção diz por que o knip não enxerga o uso;
// docs/desenvolvimento/ci.md descreve a tarefa.
{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  // Exports só conferidos em convex/lib/: os outros workspaces ainda não passam na checagem.
  // O _generated/api.d.ts importa cada módulo como namespace, por isso entram nsExports e
  // nsTypes. Um export usado só no próprio arquivo não é código morto.
  "ignoreIssues": { "!platform/convex/lib/**": ["exports", "types", "nsExports", "nsTypes"] },
  "ignoreExportsUsedInFile": true,
  // Desligado em todos os workspaces: o plugin Vite trata cada arquivo de um import.meta.glob
  // como entrada sem conferência de exports, e o glob do convex-test
  // (tests/helpers/convex-modules.ts) alcança todo platform/convex/**. As entradas que o
  // plugin achava ficam declaradas nos workspaces.
  "vite": false,
  "workspaces": {
    ".": {
      "entry": [
        // Comandos de package.json, workflows e vite.config.ts (tarefas do Vite Task).
        "scripts/*.{mjs,ts}",
        "scripts/!(lib)/*.{mjs,ts}",
        ".github/scripts/*.mjs",
        "tests/**/*.test.ts",
        "tests/setup/*.ts",
        "tooling/**/*.test.ts",
        "deploy/**/*.{ts,mjs}",
        "examples/**/*.{ts,mjs}",
        // Copiados por prove-xml-package.mjs e prove-distribution.mjs para um consumidor
        // limpo e executados lá, nunca importados.
        "scripts/lib/*-consumer.mjs",
        // Fixtures que ci.fileIsolation.test.ts executa num Vitest próprio e que
        // ci.testProjects.test.ts lê pelo caminho.
        "tests/fixtures/file-isolation/**",
        "tests/fixtures/mock-scan/**",
        // Plugin do Oxlint que vite.config.ts carrega pelo caminho (jsPlugins).
        "tooling/oxlint-plugin-freecorps/index.mjs",
      ],
      "project": [
        "scripts/**/*.{mjs,ts}",
        "tests/**/*.{ts,tsx,mjs}",
        "tooling/**/*.{mjs,ts}",
        ".github/scripts/**/*.mjs",
        "deploy/**/*.{ts,mjs}",
        "examples/**/*.{ts,mjs}",
      ],
      // Fixadas na versão exata que o Vite+ exige (docs/desenvolvimento/ci.md,
      // Instalação reproduzível); o Vite+ as carrega, nenhum arquivo as importa.
      "ignoreDependencies": ["oxfmt", "oxlint", "oxlint-tsgolint"],
    },
    "platform": {
      // O que o Convex publica como função, em vez do convex/** do plugin Convex, que faria
      // de cada helper de convex/lib/ uma entrada e esconderia o órfão.
      "entry": [
        "test-setup.ts",
        "installation.ts",
        "account-policy.mjs",
        "convex/*.ts",
        "convex/testing/*.ts",
        "convex/**/*.test.ts",
      ],
      "project": ["**/*.{ts,mjs}"],
      "convex": false,
    },
    "apps/console": {
      "entry": [
        "src/main.tsx",
        "e2e/**/*.{mjs,ts}",
        "src/**/*.test.{ts,tsx}",
        // Script do index.html e figuras que site/landing/client.ts carrega por
        // import.meta.glob.
        "src/entry.ts",
        "src/site/landing/figures/*.client.ts",
      ],
      "project": ["**/*.{ts,tsx,mjs}"],
    },
    "apps/docs": {
      "entry": ["app/**/*.{ts,tsx}", "content/**/*.mdx", "scripts/*.mjs"],
      "project": ["**/*.{ts,tsx,mjs,mdx,css}"],
    },
    "packages/*": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.{ts,mjs}"],
    },
    "packages/sdk": {
      // published/ guarda as declarações da versão publicada, que só o gate de
      // compatibilidade (scripts/lib/sdk-compat.mjs) carrega, pelo caminho do registro.
      "project": ["**/*.{ts,mjs}", "!published/**"],
      // O SDK importa ../../contracts/src por caminho relativo e empacota o zod junto
      // (THIRD_PARTY_NOTICES.txt); as entradas declaram o que o pacote leva.
      "ignoreDependencies": ["@freecorps/contracts", "zod"],
    },
  },
}
