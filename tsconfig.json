{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "allowArbitraryExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "platform/convex",
    "tests",
    "scripts",
    "tooling",
    "vite.config.ts",
    "packages",
    "examples",
    "apps/console/*.test.ts",
    "apps/docs/scripts/*.test.ts"
  ],
  // ci:distribution apaga e recria packages/contracts/dist (contracts:build) ao
  // lado de ci:typecheck e ci:check; nada importa esse dist, cujos exports
  // apontam para src/. Os outros dist saem de tarefas que terminam antes.
  // packages/sdk/published guarda as declarações da versão publicada do SDK, que
  // só o gate de compatibilidade (scripts/lib/sdk-compat.mjs) compila.
  "exclude": ["**/node_modules", "packages/contracts/dist", "packages/sdk/published"]
}
