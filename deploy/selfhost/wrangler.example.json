{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fiscal-installation-example",
  "main": "worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["AUTH_PROXY_SECRET"] },
  "vars": {
    "BACKEND_SITE_URL": "https://backend.example.invalid",
    "CONSOLE_ORIGIN": "https://console.example.invalid",
    "API_ORIGIN": "https://api.example.invalid"
  },
  "assets": {
    "directory": "../../.selfhost/hosted/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/auth/*", "/v1/*", "/health", "/docs/404"],
    "not_found_handling": "none"
  }
}
