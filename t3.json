{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "bun run worktree:setup",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    { "name": "Dev", "command": "bun run dev", "icon": "play" },
    { "name": "Worktree doctor", "command": "bun run worktree doctor", "icon": "debug" },
    { "name": "Estado do worktree", "command": "bun run worktree status", "icon": "debug" },
    { "name": "Aguardar setup", "command": "bun run worktree wait", "icon": "configure" },
    { "name": "Parar worktree", "command": "bun run worktree:cleanup", "icon": "configure" },
    { "name": "Matar órfãos", "command": "bun run worktree:reap", "icon": "debug" },
    { "name": "Concluir worktree", "command": "bun run worktree:finish", "icon": "configure" },
    { "name": "Testes", "command": "bun run -- vp test run", "icon": "test" },
    { "name": "Typecheck", "command": "bun run platform:check", "icon": "build" },
    { "name": "Validar alterações", "command": "bun run ci:local", "icon": "test" },
    { "name": "Provar commit", "command": "bun run ci:prove", "icon": "test" }
  ]
}
