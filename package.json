{
  "name": "freecorpsnfe",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "workspaces": [
    "platform",
    "apps/console",
    "apps/docs",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "backup:collect": "node scripts/backup-offsite.mjs collect",
    "backup:prove-capacity": "node scripts/prove-backup-capacity.mjs",
    "help": "node scripts/commands.mjs help",
    "ci:boundaries": "node scripts/check-package-boundaries.mjs",
    "validation:browser": "node apps/console/e2e/m0.mjs",
    "bench:navigation": "node apps/console/e2e/navigation-bench.mjs",
    "bench:workflow": "node scripts/bench-workflow-locks.mjs",
    "ci:test": "node scripts/ci.mjs identity-test",
    "ci:local": "bun scripts/validate-local.mjs",
    "ci:prove": "bun scripts/prove-acceptance.mjs",
    "validation:accounts": "node scripts/validation-accounts.mjs",
    "console:build": "vp run ci:docs && node scripts/console.mjs build",
    "validation:console:deploy": "vp run ci:docs && node scripts/console.mjs deploy",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "vp run ci:docs",
    "validation:check": "node scripts/validation.mjs check",
    "validation:backup": "node scripts/validation.mjs backup",
    "validation:verify-persistence": "node scripts/validation.mjs verify-persistence",
    "validation:deploy": "node scripts/validation.mjs deploy",
    "validation:probe:create": "node scripts/validation.mjs probe-create",
    "validation:probe:read": "node scripts/validation.mjs probe-read",
    "dev": "bun scripts/dev.mjs",
    "build": "node scripts/build-fiscal-packages.mjs && node scripts/typecheck.mjs -p tsconfig.platform.json && vp run ci:docs && node scripts/console.mjs build",
    "worktree": "bun scripts/worktree.mjs",
    "worktree:create": "bun scripts/worktree.mjs create",
    "worktree:list": "bun scripts/worktree.mjs list",
    "worktree:remove": "bun scripts/worktree.mjs remove",
    "worktree:prune": "bun scripts/worktree.mjs prune",
    "worktree:setup": "bun scripts/worktree.mjs setup",
    "worktree:dev": "bun scripts/worktree.mjs dev",
    "worktree:sync": "bun scripts/worktree.mjs sync",
    "worktree:seed": "bun scripts/worktree.mjs seed",
    "worktree:doctor": "bun scripts/worktree.mjs doctor",
    "worktree:status": "bun scripts/worktree.mjs status",
    "worktree:wait": "bun scripts/worktree.mjs wait",
    "worktree:cleanup": "bun scripts/worktree.mjs cleanup",
    "worktree:finish": "bun scripts/worktree.mjs finish",
    "packages:build": "node scripts/build-fiscal-packages.mjs",
    "xml:check": "tsc -p packages/fiscal-nfe/tsconfig.json --noEmit",
    "xml:test": "vp test run packages/fiscal-nfe",
    "nfse:test": "vp test run packages/fiscal-nfse",
    "xml:prove": "node scripts/prove-xml-package.mjs",
    "xml:portal": "node scripts/check-nfe-schemas.mjs",
    "platform:check": "node scripts/build-fiscal-packages.mjs && node scripts/typecheck.mjs -p tsconfig.platform.json && node scripts/typecheck.mjs -p apps/console/tsconfig.json",
    "platform:test": "vp run test:platform && vp run test:packages",
    "usage:migration:status": "node scripts/usage-migration-status.mjs",
    "archive:cold": "node scripts/cold-archive.mjs",
    "archive:prove-local": "node scripts/prove-cold-archive-local.mjs",
    "content:prove-local": "node scripts/prove-document-content-local.mjs",
    "cold:prove-hosted": "node scripts/prove-cold-tier-hosted.mjs",
    "cold:prove-rehydration": "node scripts/prove-cold-rehydration-local.mjs",
    "content:prove-hosted": "node scripts/prove-document-content-hosted.mjs",
    "plans:browser": "node apps/console/e2e/plans.mjs",
    "billing:check-stripe": "node scripts/check-billing-stripe.mjs",
    "test:changed": "vp test run --changed origin/main --passWithNoTests",
    "worktree:mail": "bun scripts/worktree.mjs mail",
    "platform:browser": "node --experimental-strip-types apps/console/e2e/foundation.mjs",
    "platform:worker": "node --experimental-strip-types scripts/prove-auth-worker.mjs",
    "platform:privacy-worker": "node scripts/prove-privacy-mail-worker.mjs",
    "deploy:mail": "wrangler deploy --config deploy/privacy-mail/wrangler.jsonc",
    "xml:runtime": "node scripts/prove-nfe-runtime.mjs",
    "contracts:generate": "bun scripts/generate-contracts.mjs",
    "contracts:check": "bun scripts/generate-contracts.mjs --check",
    "contracts:build": "node scripts/build-contracts.mjs",
    "sdk:build": "bun scripts/build-sdk.mjs",
    "sdk:prove": "bun scripts/prove-sdk-package.mjs",
    "licenses:inventory": "node scripts/inventory-licenses.mjs",
    "licenses:check": "node scripts/inventory-licenses.mjs --check && node scripts/check-first-party-licenses.mjs && node scripts/prepare-package-notices.mjs --check",
    "distribution:prove": "bun scripts/prove-distribution.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "public:tree": "node scripts/public-tree.mjs",
    "xml:build": "node scripts/commands.mjs renamed xml:build",
    "xml:boundaries": "node scripts/commands.mjs renamed xml:boundaries",
    "console:deploy": "node scripts/commands.mjs renamed console:deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@xmldom/xmldom": "0.8.15",
    "convex": "^1.48.0",
    "fast-xml-parser": "^5.11.2",
    "libxml2-wasm": "0.7.2",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@freecorps/freecorpsnfe-sdk": "workspace:*",
    "@napi-rs/canvas": "1.0.10",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "convex-test": "^0.0.60",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "pdfjs-dist": "^6.4.299",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "@convex-dev/better-auth@0.12.5": "patches/@convex-dev%2Fbetter-auth@0.12.5.patch",
    "@convex-dev/workpool@0.4.12": "patches/@convex-dev%2Fworkpool@0.4.12.patch",
    "@convex-dev/rate-limiter@0.3.2": "patches/@convex-dev%2Frate-limiter@0.3.2.patch"
  }
}
