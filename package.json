{
  "name": "freecorpsnfe",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "workspaces": [
    "platform",
    "apps/console",
    "apps/docs",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "backup:collect": "node scripts/backup/backup-offsite.mjs collect",
    "backup:prove-capacity": "node scripts/backup/prove-backup-capacity.mjs",
    "help": "node scripts/repo/commands.mjs help",
    "ci:boundaries": "node scripts/build/check-package-boundaries.mjs",
    "validation:browser": "node apps/console/e2e/m0.mjs",
    "bench:navigation": "node apps/console/e2e/navigation-bench.mjs",
    "bench:workflow": "node scripts/ci/bench-workflow-locks.mjs",
    "ci:test": "node scripts/ci/ci.mjs identity-test",
    "ci:local": "bun scripts/ci/validate-local.mjs",
    "ci:prove": "bun scripts/ci/prove-acceptance.mjs",
    "validation:accounts": "node scripts/validation/validation-accounts.mjs",
    "console:build": "vp run ci:docs && node scripts/console/console.mjs build",
    "validation:console:deploy": "vp run ci:docs && node scripts/console/console.mjs deploy",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "vp run ci:docs",
    "validation:check": "node scripts/validation/validation.mjs check",
    "validation:backup": "node scripts/validation/validation.mjs backup",
    "validation:verify-persistence": "node scripts/validation/validation.mjs verify-persistence",
    "validation:deploy": "node scripts/validation/validation.mjs deploy",
    "validation:probe:create": "node scripts/validation/validation.mjs probe-create",
    "validation:probe:read": "node scripts/validation/validation.mjs probe-read",
    "dev": "bun scripts/worktree/dev.mjs",
    "build": "node scripts/build/build-fiscal-packages.mjs && node scripts/build/typecheck.mjs -p tsconfig.platform.json && vp run ci:docs && node scripts/console/console.mjs build",
    "worktree": "bun scripts/worktree.mjs",
    "worktree:create": "bun scripts/worktree.mjs create",
    "worktree:setup": "bun scripts/worktree.mjs setup",
    "worktree:dev": "bun scripts/worktree.mjs dev",
    "worktree:cleanup": "bun scripts/worktree.mjs cleanup",
    "worktree:finish": "bun scripts/worktree.mjs finish",
    "packages:build": "node scripts/build/build-fiscal-packages.mjs",
    "xml:check": "tsc -p packages/fiscal-nfe/tsconfig.json --noEmit",
    "xml:test": "vp test run packages/fiscal-nfe",
    "nfse:test": "vp test run packages/fiscal-nfse",
    "xml:prove": "node scripts/distribution/prove-xml-package.mjs",
    "xml:portal": "node scripts/fiscal/check-nfe-schemas.mjs",
    "platform:check": "node scripts/build/build-fiscal-packages.mjs && node scripts/build/typecheck.mjs -p tsconfig.platform.json && node scripts/build/typecheck.mjs -p apps/console/tsconfig.json",
    "platform:test": "vp run test:platform && vp run test:packages",
    "usage:migration:status": "node scripts/billing/usage-migration-status.mjs",
    "archive:cold": "node scripts/cold-tier/cold-archive.mjs",
    "archive:prove-local": "node scripts/cold-tier/prove-cold-archive-local.mjs",
    "content:prove-local": "node scripts/proofs/prove-document-content-local.mjs",
    "cold:prove-hosted": "node scripts/cold-tier/prove-cold-tier-hosted.mjs",
    "cold:prove-rehydration": "node scripts/cold-tier/prove-cold-rehydration-local.mjs",
    "content:prove-hosted": "node scripts/proofs/prove-document-content-hosted.mjs",
    "plans:browser": "node apps/console/e2e/plans.mjs",
    "test:changed": "vp test run --changed origin/main --passWithNoTests",
    "check:changed": "node scripts/ci/check-changed.mjs",
    "platform:browser": "node --experimental-strip-types apps/console/e2e/foundation.mjs",
    "platform:worker": "node --experimental-strip-types scripts/proofs/prove-auth-worker.mjs",
    "xml:runtime": "node scripts/fiscal/prove-nfe-runtime.mjs",
    "contracts:generate": "bun scripts/contracts/generate-contracts.mjs",
    "contracts:check": "bun scripts/contracts/generate-contracts.mjs --check",
    "contracts:build": "node scripts/contracts/build-contracts.mjs",
    "sdk:build": "bun scripts/contracts/build-sdk.mjs",
    "sdk:prove": "bun scripts/contracts/prove-sdk-package.mjs",
    "licenses:inventory": "node scripts/licenses/inventory-licenses.mjs",
    "licenses:check": "node scripts/licenses/inventory-licenses.mjs --check && node scripts/licenses/check-first-party-licenses.mjs && node scripts/licenses/prepare-package-notices.mjs --check",
    "distribution:prove": "bun scripts/distribution/prove-distribution.mjs",
    "secrets:check": "node scripts/public-copy/check-secrets.mjs",
    "knip:check": "knip --include files,dependencies,exports,types,nsExports,nsTypes --no-progress",
    "public:tree": "node scripts/public-copy/public-tree.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@freecorps/freecorpsnfe-sdk": "workspace:*",
    "@napi-rs/canvas": "1.0.10",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/node-forge": "1.3.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "convex": "1.48.0",
    "convex-test": "0.0.60",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "knip": "6.42.1",
    "node-forge": "1.4.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "4.152.0",
    "xml-crypto": "6.4.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "@convex-dev/better-auth@0.12.5": "patches/@convex-dev%2Fbetter-auth@0.12.5.patch",
    "convex-test@0.0.60": "patches/convex-test@0.0.60.patch"
  }
}
